# DevHandover AI - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ===========================================
# Database Configuration
# ===========================================
# SQLite (default for development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (for production)
# DATABASE_URL="postgresql://user:password@localhost:5432/devhandover?schema=public"

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# ===========================================
# GitHub OAuth Configuration (Optional)
# ===========================================
# Get these from GitHub Developer Settings > OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/github/callback

# ===========================================
# LLM Provider Configuration
# ===========================================
# Provider: openai | nim | custom
LLM_PROVIDER=openai

# OpenAI API Key (required for openai provider)
LLM_API_KEY=

# Custom base URL for NVIDIA NIM or other OpenAI-compatible endpoints
# Example for NVIDIA NIM: https://integrate.api.nvidia.com/v1
LLM_BASE_URL=

# Model to use
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# NVIDIA NIM: meta/llama-3.1-70b-instruct, meta/llama-3.1-8b-instruct
LLM_MODEL=gpt-4o

# ===========================================
# JWT Configuration (Future Auth)
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL=info